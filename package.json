  "version": "1.1.4",
  "description": "Atlas Method - multi-runner AI session method (constitution template, installer, adapters)",
  "license": "MIT",
  "bin": {
    "atlas": "./bin/atlas.js"
  },
  "scripts": {
    "build-manifest": "node scripts/build-manifest.js",
